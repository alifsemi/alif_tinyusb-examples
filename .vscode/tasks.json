{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmsis-csolution.build",
            "solution": "${command:cmsis-csolution.getSolutionPath}",
            "rebuild": false,
            "problemMatcher": [],
            "label": "cmsis-csolution.build: Build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "First time pack installation",
            "type": "shell",
            "command": [
                "cpackget init https://www.keil.com/pack/index.pidx;",
                "cpackget add https://github.com/ARM-software/CMSIS_6/releases/download/v6.2.0/ARM.CMSIS.6.2.0.pack;",
                "cpackget add https://github.com/alifsemi/alif_ensemble-cmsis-dfp/releases/download/v2.1.0/AlifSemiconductor.Ensemble.2.1.0.pack;",
                "cpackget add https://github.com/ARM-software/CMSIS-FreeRTOS/releases/download/v11.2.0/ARM.CMSIS-FreeRTOS.11.2.0.pack;",
                "cpackget list;",
                "echo 'Pack installation has been completed'"
            ],
            "problemMatcher": []
        },
        {
            "label": "Prepare program with Security Toolkit",
            "type": "shell",
            "windows": {
                "command": [
                    "$outputElfFilename='${command:cmsis-csolution.getBinaryFile}';",
                    "$outputBinFilename=${outputElfFilename}.Substring(0, $outputElfFilename.Length -3) + 'bin';",
                    "cp \"$outputBinFilename\" '${config:alif.setools.root}/build/images/alif-img.bin';",
                    "cp './.alif/${command:cmsis-csolution.getProcessorName}_cfg.json' '${config:alif.setools.root}/alif-img.json';"
                ]
            },
            "linux": {
                "command": [
                    "outputElfFilename='${command:cmsis-csolution.getBinaryFile}';",
                    "cp \"${outputElfFilename/%???/bin}\" '${config:alif.setools.root}/build/images/alif-img.bin';",
                    "cp './.alif/${command:cmsis-csolution.getProcessorName}_cfg.json' '${config:alif.setools.root}/alif-img.json';"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Program with Security Toolkit",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "./app-gen-toc -f alif-img.json;",
                "./app-write-mram -p;",
                "rm ./build/images/alif-img.bin;",
                "rm ./alif-img.json;"
            ],
            "problemMatcher": [],
            "dependsOn": "Prepare program with Security Toolkit"
        },
        {
            "label": "Program with Security Toolkit (select COM port)",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "./app-gen-toc -f alif-img.json;",
                "./app-write-mram -p -d;",
                "rm ./build/images/alif-img.bin;",
                "rm ./alif-img.json;"
            ],
            "problemMatcher": [],
            "dependsOn": "Prepare program with Security Toolkit"
        },
        {
            "label": "Program opened binary file to M55_HP",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "outputBinFilename='${fileDirname}/${fileBasenameNoExtension}.bin';",
                "cp ${outputBinFilename} '${config:alif.setools.root}/build/images/alif-img.bin';",
                "cp ${workspaceFolder}/.alif/M55_HP_cfg.json '${config:alif.setools.root}/alif-img.json';",
                "./app-gen-toc -f alif-img.json;",
                "./app-write-mram -p;",
                "rm ./build/images/alif-img.bin;",
                "rm ./alif-img.json;"
            ],
            "problemMatcher": []
        },
        {
            "label": "Program opened binary file to M55_HE",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "outputBinFilename='${fileDirname}/${fileBasenameNoExtension}.bin';",
                "cp ${outputBinFilename} '${config:alif.setools.root}/build/images/alif-img.bin';",
                "cp ${workspaceFolder}/.alif/M55_HE_cfg.json '${config:alif.setools.root}/alif-img.json';",
                "./app-gen-toc -f alif-img.json;",
                "./app-write-mram -p;",
                "rm ./build/images/alif-img.bin;",
                "rm ./alif-img.json;"
            ],
            "problemMatcher": []
        },
        {
            "label": "Update TOC with Security Toolkit",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "./app-gen-toc -f alif-img.json;",
                "./app-write-mram -S;",
                "rm ./build/images/alif-img.bin;",
                "rm ./alif-img.json;"
            ],
            "problemMatcher": [],
            "dependsOn": "Prepare program with Security Toolkit"
        },
        {
            "label": "Install debug stubs with Security Toolkit",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "./app-gen-toc -f ./build/config/app-cpu-stubs.json;",
                "./app-write-mram;"
            ],
            "problemMatcher": []
        },
        {
            "label": "Install debug stubs with Security Toolkit (select COM port)",
            "type": "shell",
            "options": {
                "cwd": "${config:alif.setools.root}"
            },
            "command": [
                "./app-gen-toc -f ./build/config/app-cpu-stubs.json;",
                "./app-write-mram -d;"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMSIS Erase",
            "type": "shell",
            "command": [
                "echo Connect > .cmd.jlink &&",
                "echo Erase >> .cmd.jlink &&",
                "echo Exit >> .cmd.jlink &&",
                "JLinkExe -device AE822FA0E5597LS0_M55_HE -if swd -speed 4000 -commandfile .cmd.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMSIS Load",
            "type": "shell",
            "command": [
                "echo Connect > .cmd.jlink &&",
                "echo LoadFile \"out/device_cdc_msc/DevKit-E8-HE/debug/device_cdc_msc.elf\" >> .cmd.jlink &&",
                "echo Exit >> .cmd.jlink &&",
                "JLinkExe -device AE822FA0E5597LS0_M55_HE -if swd -speed 4000 -commandfile .cmd.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "CMSIS Run",
            "type": "shell",
            "command": "JLinkGDBServerCLExe",
            "options": {
                "cwd": "${workspaceFolder}/",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "args": [
                "-device",
                "AE822FA0E5597LS0_M55_HE",
                "-endian",
                "little",
                "-if",
                "swd",
                "-speed",
                "4000",
                "-nohalt",
                "-noir",
                "-nogui",
                "-localhostonly",
                "-silent",
                "-port",
                "3333",
                "-TelnetPort",
                "4444"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMSIS Load+Run",
            "dependsOn": [
                "CMSIS Load",
                "CMSIS Run"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
